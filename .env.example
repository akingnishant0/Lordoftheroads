# ===========================================
# Lord of the Road — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# ---- Database (PostgreSQL) ----
# Free cloud DB: sign up at https://neon.tech, create a project, copy the connection string.
DATABASE_URL="postgresql://user:password@host:5432/lordoftheroad?sslmode=require"

# ---- NextAuth ----
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE-ME-generate-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Razorpay (Phase 5 — leave empty for now) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Facebook Lead Ads (Phase 3 — leave empty for now) ----
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_VERIFY_TOKEN=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# ---- Google Ads (Phase 3 — leave empty for now) ----
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_WEBHOOK_SECRET=""

# ---- Justdial (Phase 3 — leave empty for now) ----
JUSTDIAL_WEBHOOK_SECRET=""
JUSTDIAL_IMAP_HOST=""
JUSTDIAL_IMAP_USER=""
JUSTDIAL_IMAP_PASS=""

# ---- Generic Webhook API Key (Phase 3) ----
GENERIC_WEBHOOK_API_KEY=""

# ---- Email SMTP (Phase 5 — leave empty for now) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@lordoftheroad.in"

# ---- WhatsApp Business API (Phase 5 — leave empty for now) ----
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
